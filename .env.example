# Copy this file to .env and fill in the values. Never commit .env.
#
# Local development runs against the local Supabase stack (Supabase CLI + Docker).
# Run `npx supabase status` after `npx supabase start` to print both values.
# Production values live only in EAS environment variables, never in this file.
# See "Environment setup" in the README.

# API URL. For the local stack this is http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_URL=

# anon key (newer Supabase CLI versions call it the publishable key). Safe to ship
# in the app because RLS protects the data. Never put the service_role / secret key
# here: EXPO_PUBLIC_ values are bundled into the app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
