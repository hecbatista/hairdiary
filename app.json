{
  "expo": {
    "name": "hair-diary",
    "slug": "hair-diary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/AppIcon.icon",
      "bundleIdentifier": "com.hbatista908.hair-diary"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EAD9D1"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#EAD9D1",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#2B2320"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b3b55018-f8cb-4706-a15a-49b49661a890"
      }
    },
    "owner": "hbatista908"
  }
}
